# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://umbrellanetwork.in"
NEXT_PUBLIC_APP_URL="https://umbrellanetwork.in"

# Join Masterclass popup interval in milliseconds. Default is 3 minutes.
NEXT_PUBLIC_JOIN_POPUP_INTERVAL_MS="180000"

# Supabase. The anon key may be public. The service role key must stay on the server.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Razorpay. The key id may be public. The secret and webhook secret must stay on the server.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_key"

# Resend transactional email. Never expose the API key to the browser.
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="contact@yourdomain.com"
ADMIN_EMAIL="caumbrellanetwork@gmail.com"

# Invoice business details
BUSINESS_NAME="The Umbrella Network"
BUSINESS_EMAIL="caumbrellanetwork@gmail.com"
BUSINESS_PHONE="+91 9996506041"
BUSINESS_ADDRESS="India"
BUSINESS_GSTIN=""

# Google service account JSON with Drive and Sheets access.
# Share the Drive folder and the spreadsheet with the service account email.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_DRIVE_RESOURCES_URL="https://drive.google.com/drive/folders/your-folder-id"
GOOGLE_SHEET_ID=""
GOOGLE_SHEETS_TAB="Registrations"

# Admin login. Use a long random password and session secret.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
ADMIN_SESSION_SECRET="change-this-to-a-long-random-string"

# Netlify scheduled function uses this to retry failed emails, Drive access and sheet sync.
CRON_SECRET="change-this-cron-secret"

# Fallback course price used only if a batch fee is missing. Live charges use the batch fee stored in Supabase.
MASTERCLASS_PRICE_INR="999"
